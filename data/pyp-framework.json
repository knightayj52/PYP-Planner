  "inquiryModels": [
    {
      "id": "murdoch5",
      "ko": "머독(Murdoch) 탐구 사이클",
      "en": "Murdoch Inquiry Cycle",
      "source": "Murdoch(2015)",
      "stageCount": 5,
      "note": "일반화 수렴 활동은 '범주화하기'와 '더 나아가기' 단계에 분산 배치한다.",
      "stages": [
        {
          "id": "tuningIn",
          "ko": "준비하기",
          "en": "Tuning in",
          "goals": [
            "학생들의 사전 지식 활성화(이해도와 오개념 확인)",
            "흥미와 태도 파악",
            "시청각 자료와 도발적 질문으로 호기심 자극",
            "학생들을 주제에 참여시키기"
          ]
        },
        {
          "id": "findingOut",
          "ko": "찾아내기",
          "en": "Finding out",
          "goals": [
            "새로운 정보를 계획적으로 조사·연구하고 생각을 논의·공유하도록 지원",
            "기능과 지식을 사용해 새로운 정보 수집"
          ]
        },
        {
          "id": "sortingOut",
          "ko": "범주화하기",
          "en": "Sorting out",
          "goals": [
            "찾은 정보와 자료를 선별·정리(구성)하여 제시",
            "의미 부여와 관련성 확인으로 패턴과 경향 발견",
            "선호하는 학습 방법을 사용할 기회 제공"
          ]
        },
        {
          "id": "goingFurther",
          "ko": "더 나아가기",
          "en": "Going further",
          "goals": [
            "주제에 대한 또 다른 관점이나 차원 제시",
            "개인적 관심 분야 탐색(조사)",
            "관련 개념에 대한 깊은 이해를 위한 자유 탐구"
          ]
        },
        {
          "id": "reflectingActing",
          "ko": "성찰 및 행동하기",
          "en": "Reflecting and acting",
          "goals": [
            "자신의 아이디어를 적용하기",
            "학습을 실제 상황과 연관 짓기",
            "배운 개념을 바탕으로 실생활에서 행동 실천하기"
          ]
        }
      ]
    },
    {
      "id": "marschallFrench7",
      "ko": "마샬·프렌치(Marschall & French) 개념 기반 탐구",
      "en": "Marschall & French Concept-Based Inquiry",
      "source": "Marschall & French(2016/2018)",
      "stageCount": 7,
      "note": "성찰하기는 별도 단계이면서 전 과정에 스며든다. 단원 수준에서 일곱 단계 모두 포함(반복 가능, 누락 불가).",
      "stages": [
        {
          "id": "engage",
          "ko": "관계 맺기",
          "en": "Engage",
          "goals": [
            "학습 주제에 관심 갖게 하기",
            "사전 지식 끌어내고 평가하기",
            "질문을 유도하고 초기 질문 모으기",
            "학습의 목적과 범위 설정"
          ]
        },
        {
          "id": "focus",
          "ko": "집중하기",
          "en": "Focus",
          "goals": [
            "단원의 주요 개념과 관련 개념을 함께 이해하도록 하기",
            "조사하기 단계에서 더 알아볼 사실적 예 소개"
          ]
        },
        {
          "id": "investigate",
          "ko": "조사하기",
          "en": "Investigate",
          "goals": [
            "사실적 예와 사례연구를 조사해 단원 개념과 연결하기",
            "교과 내 또는 교과 간 기능 습득"
          ]
        },
        {
          "id": "organize",
          "ko": "조직 및 정리하기",
          "en": "Organize",
          "goals": [
            "다양한 자료·방법·교과로 개념과 생각 나타내기",
            "사실적·개념적 수준에서 생각 구성하기"
          ]
        },
        {
          "id": "generalize",
          "ko": "일반화하기",
          "en": "Generalize",
          "goals": [
            "사실적 예시 안의 패턴과 연결성 발견",
            "전이 가능한 개념적 이해를 명확히 하기"
          ]
        },
        {
          "id": "transfer",
          "ko": "전이하기",
          "en": "Transfer",
          "goals": [
            "새로운 상황에 일반화 적용하기",
            "학습에 관한 의미 있는 행동 실천하기"
          ]
        },
        {
          "id": "reflect",
          "ko": "성찰하기",
          "en": "Reflect",
          "goals": [
            "탐구 과정 중과 마지막에 개별·그룹으로 평가하기",
            "자신의 학습 과정을 계획하고 조절하도록 하기"
          ]
        }
      ]
    }
  ],
  "qualityCriteria": {
    "concept": {
      "label": "개념의 조건 (BATU)",
