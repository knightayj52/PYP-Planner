  "keyConcepts": [
    {
      "id": "form",
      "ko": "형태",
      "en": "Form",
      "keyQuestion": "어떤 모습인가?",
      "definition": "모든 것은 관찰·식별·설명이 가능하고 범주로 분류할 수 있는, 인식 가능한 특징(형태)을 가진다.",
      "relatedConceptExamples": [
        "성질",
        "구조",
        "유사점",
        "차이점",
        "패턴"
      ]
    },
    {
      "id": "function",
      "ko": "기능",
      "en": "Function",
      "keyQuestion": "어떻게 작용하는가?",
      "definition": "모든 것은 조사할 수 있는 목적, 역할, 행동 방식을 가진다.",
      "relatedConceptExamples": [
        "행동",
        "소통",
        "패턴",
        "역할",
        "체제"
      ]
    },
    {
      "id": "causation",
      "ko": "인과 관계",
      "en": "Causation",
      "keyQuestion": "왜 그런가?",
      "definition": "어떤 일도 이유 없이 일어나지 않으며, 모든 일에는 인과 관계가 있고 행동에는 결과가 따른다.",
      "relatedConceptExamples": [
        "결과",
        "순서",
        "패턴",
        "영향"
      ]
    },
    {
      "id": "change",
      "ko": "변화",
      "en": "Change",
      "keyQuestion": "어떻게 변하고 있는가?",
      "definition": "변화는 한 상태에서 다른 상태로 이동하는 과정이며, 보편적이고 불가피하다.",
      "relatedConceptExamples": [
        "적응",
        "성장",
        "주기",
        "순서",
        "변형"
      ]
    },
    {
      "id": "connection",
      "ko": "연결성",
      "en": "Connection",
      "keyQuestion": "다른 것과 어떻게 연결되어 있는가?",
      "definition": "우리는 개별 요소의 행동이 다른 것에 영향을 미치는 상호작용 체계의 세계에 살고 있다.",
      "relatedConceptExamples": [
        "체제",
        "관계",
        "연결망",
        "항상성",
        "상호의존"
      ]
    },
    {
      "id": "perspective",
      "ko": "관점",
      "en": "Perspective",
      "keyQuestion": "관점이란 무엇인가?",
      "definition": "지식은 서로 다른 관점에 의해 중재되며, 관점에 따라 해석·이해·관찰 결과가 달라진다. 관점은 개인적·집단적·문화적·학문적일 수 있다.",
      "relatedConceptExamples": [
        "주관성",
        "진실",
        "신념",
        "의견",
        "편견"
      ]
    },
    {
      "id": "responsibility",
      "ko": "책임",
      "en": "Responsibility",
      "keyQuestion": "우리의 의무는 무엇인가?",
      "definition": "사람은 자신의 이해·신념·가치에 기반해 선택하고, 그 선택에 따른 실천으로 변화를 만들 수 있다.",
      "relatedConceptExamples": [
        "권리",
        "시민 의식",
        "가치",
        "정의",
        "주도성"
      ]
    }
  ],
